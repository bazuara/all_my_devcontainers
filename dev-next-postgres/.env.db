#  database environment file:
# This file is used to set up the PostgreSQL database connection for the project.
# - POSTGRES_USER: The username used to connect to the PostgreSQL database.
# - POSTGRES_PASSWORD: The password used to connect to the PostgreSQL database.
# - POSTGRES_DB: The name of the PostgreSQL database to connect to.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=suggestions

